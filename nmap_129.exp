#!/usr/bin/expect -f
set timeout 30
spawn ssh -o StrictHostKeyChecking=no administrator@110.78.210.129
expect "*assword:*"
send "P@ssw0rd1234\r"
expect "*$*"

send "sudo apt-get install -y nmap\r"
expect {
    "*assword*" {
        send "P@ssw0rd1234\r"
        expect "*$*"
    }
    "*$*" {}
}

send "nmap -p 1-10000 110.78.210.129\r"
expect "*$*"

send "exit\r"
expect eof
