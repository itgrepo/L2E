#!/usr/bin/expect -f
set timeout 20
spawn ssh -o StrictHostKeyChecking=no administrator@110.78.210.133
expect "*assword:*"
send "P@ssw0rd1234\r"
expect "*$*"
send "curl -I http://127.0.0.1:8080\r"
expect "*$*"
send "sudo iptables -I INPUT -p tcp --dport 8080 -j ACCEPT\r"
expect {
    "*assword*" {
        send "P@ssw0rd1234\r"
        expect "*$*"
    }
    "*$*" {}
}
send "exit\r"
expect eof
