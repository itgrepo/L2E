#!/usr/bin/expect -f

set timeout 20
set ip "110.78.210.133"
set user "administrator"
set password "P@ssw0rd1234"

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"

expect "*$*"
send "sudo ufw allow 8080\r"
expect "*assword:*"
send "$password\r"

expect "*$*"
send "exit\r"
expect eof
