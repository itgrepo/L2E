#!/usr/bin/expect -f
set timeout 60
spawn ssh -t administrator@110.78.210.129 "sudo docker exec datax_db_3001 mysql -u root -prootpassword datax_db_3001 -e \"CREATE TABLE IF NOT EXISTS token_forgotpassword (id INT AUTO_INCREMENT PRIMARY KEY, token VARCHAR(255) NOT NULL, username VARCHAR(100) NOT NULL, email VARCHAR(150) NOT NULL, status VARCHAR(50) DEFAULT 'active', created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP);\""
expect {
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "P@ssw0rd1234\r"
        exp_continue
    }
    "password for administrator:" {
        send "P@ssw0rd1234\r"
        exp_continue
    }
    eof
}
