#!/usr/bin/expect -f
set timeout 120
spawn ssh -o StrictHostKeyChecking=no administrator@110.78.210.129
expect "*assword:*"
send "P@ssw0rd1234\r"
expect "*\$*"
send "sudo -v\r"
expect { "*assword*" { send "P@ssw0rd1234\r"; expect "*\$*" } "*\$*" {} }

send "sudo docker load < /tmp/frontend_v341.tar 2>&1 | tail -1; echo L1\r"
expect "L1*\$*"
send "sudo docker load < /tmp/backend_v341.tar 2>&1 | tail -1; echo L2\r"
expect "L2*\$*"
send "sudo docker tag intelligist-datax-frontend:prod mso-frontend:prod; sudo docker tag intelligist-datax-backend:prod mso-backend:prod; echo T\r"
expect "T*\$*"
send "sudo docker rm -f astro_frontend_uat astro_backend_uat 2>/dev/null; echo R\r"
expect "R*\$*"
send "sudo docker run -d --name astro_backend_uat --restart always --network-alias backend -p 3010:7000 --network release_mso_l2e-network-uat -v uploads_data_uat:/app/uploads -e DB_HOST=db -e DB_USER=astro -e DB_PASS=password123 -e DB_NAME=psu_backend intelligist-datax-backend:prod 2>&1; echo B\r"
expect "B*\$*"
send "sleep 5; echo W\r"
expect "W*\$*"
send "sudo docker run -d --name astro_frontend_uat --restart always -p 3001:80 --network release_mso_l2e-network-uat intelligist-datax-frontend:prod 2>&1; echo F\r"
expect "F*\$*"
send "sleep 3; curl -s -o /dev/null -w '%{http_code}' http://localhost:3001; echo ' OK'\r"
expect "OK*\$*"
send "exit\r"
expect eof
