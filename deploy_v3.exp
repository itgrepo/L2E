#!/usr/bin/expect -f
set timeout 300
spawn ssh -o StrictHostKeyChecking=no administrator@110.78.210.129
expect "*assword:*"
send "P@ssw0rd1234\r"
expect "*\$*"

send "echo P@ssw0rd1234 | sudo -S docker load < /tmp/frontend_v341.tar 2>&1 | tail -1; echo LOAD1_DONE\r"
expect "LOAD1_DONE"
expect "*\$*"

send "echo P@ssw0rd1234 | sudo -S docker load < /tmp/backend_v341.tar 2>&1 | tail -1; echo LOAD2_DONE\r"
expect "LOAD2_DONE"
expect "*\$*"

send "echo P@ssw0rd1234 | sudo -S docker tag intelligist-datax-frontend:prod mso-frontend:prod && echo P@ssw0rd1234 | sudo -S docker tag intelligist-datax-backend:prod mso-backend:prod; echo TAG_DONE\r"
expect "TAG_DONE"
expect "*\$*"

send "echo P@ssw0rd1234 | sudo -S docker rm -f astro_frontend_uat astro_backend_uat 2>/dev/null; echo RM_DONE\r"
expect "RM_DONE"
expect "*\$*"

send "echo P@ssw0rd1234 | sudo -S docker run -d --name astro_backend_uat --restart always --network-alias backend -p 3010:7000 --network release_mso_l2e-network-uat -v uploads_data_uat:/app/uploads -e DB_HOST=db -e DB_USER=astro -e DB_PASS=password123 -e DB_NAME=psu_backend intelligist-datax-backend:prod 2>&1; echo BE_DONE\r"
expect "BE_DONE"
expect "*\$*"

send "sleep 5; echo WAIT_DONE\r"
expect "WAIT_DONE"
expect "*\$*"

send "echo P@ssw0rd1234 | sudo -S docker run -d --name astro_frontend_uat --restart always -p 3001:80 --network release_mso_l2e-network-uat intelligist-datax-frontend:prod 2>&1; echo FE_DONE\r"
expect "FE_DONE"
expect "*\$*"

send "sleep 3; curl -s -o /dev/null -w '%{http_code}' http://localhost:3001; echo ' HTTP_DONE'\r"
expect "HTTP_DONE"
expect "*\$*"

send "echo P@ssw0rd1234 | sudo -S docker ps --format '{{.Names}} {{.Status}}' | grep astro; echo PS_DONE\r"
expect "PS_DONE"
expect "*\$*"

send "exit\r"
expect eof
