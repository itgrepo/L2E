#!/usr/bin/expect -f
set timeout 15
spawn ssh -o StrictHostKeyChecking=no administrator@110.78.210.129
expect "*assword:*"
send "P@ssw0rd1234\r"
expect "*\$*"

send "sudo -v\r"
expect {
    "*assword*" {
        send "P@ssw0rd1234\r"
        expect "*\$*"
    }
    "*\$*" {}
}

# Check if config file exists
send "sudo docker exec astro_backend_uat cat /app/uploads/site_config.json 2>&1; echo FILE_DONE\r"
expect "FILE_DONE*\$*"

# Test the API directly
send "curl -s http://localhost:3010/site-config 2>&1; echo API_DONE\r"
expect "API_DONE*\$*"

# Test via frontend proxy
send "curl -s http://localhost:3001/api/site-config 2>&1; echo PROXY_DONE\r"
expect "PROXY_DONE*\$*"

# Test POST
send "curl -s -X POST http://localhost:3010/site-config -H 'Content-Type: application/json' -d '{\"siteName\":\"DataX Portal\",\"primaryColor\":\"#0062ff\"}' 2>&1; echo POST_DONE\r"
expect "POST_DONE*\$*"

# Verify file saved
send "sudo docker exec astro_backend_uat cat /app/uploads/site_config.json 2>&1; echo VERIFY_DONE\r"
expect "VERIFY_DONE*\$*"

send "exit\r"
expect eof
