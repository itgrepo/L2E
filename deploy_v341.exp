#!/usr/bin/expect -f
set timeout 120
spawn ssh -o StrictHostKeyChecking=no administrator@110.78.210.129
expect "*assword:*"
send "P@ssw0rd1234\r"
expect "*$*"

# Step 1: Load the new frontend image
send "echo '=== Step 1: Loading new frontend image ==='\r"
expect "*$*"
send "sudo docker load < /tmp/frontend_v341.tar\r"
expect {
    "*assword*" {
        send "P@ssw0rd1234\r"
        expect "*$*"
    }
    "*$*" {}
}

# Step 2: Tag it as the production image used by docker-compose
send "echo '=== Step 2: Tagging image ==='\r"
expect "*$*"
send "sudo docker tag intelligist-datax-frontend:prod mso-frontend:prod\r"
expect "*$*"

# Step 3: Stop old frontend container
send "echo '=== Step 3: Stopping old frontend container ==='\r"
expect "*$*"
send "sudo docker stop astro_frontend_uat\r"
expect "*$*"
send "sudo docker rm astro_frontend_uat\r"
expect "*$*"

# Step 4: Start new frontend container with same port mapping
send "echo '=== Step 4: Starting new frontend container ==='\r"
expect "*$*"
send "sudo docker run -d --name astro_frontend_uat --restart always -p 3001:80 --network l2e-network-uat_default intelligist-datax-frontend:prod\r"
expect "*$*"

# Step 5: Verify
send "echo '=== Step 5: Verifying ==='\r"
expect "*$*"
send "sudo docker ps | grep astro_frontend_uat\r"
expect "*$*"

send "exit\r"
expect eof
