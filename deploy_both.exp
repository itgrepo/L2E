#!/usr/bin/expect -f
set timeout 120
spawn ssh -o StrictHostKeyChecking=no administrator@110.78.210.129
expect "*assword:*"
send "P@ssw0rd1234\r"
expect "*\$*"

send "sudo -v\r"
expect {
    "*assword*" {
        send "P@ssw0rd1234\r"
        expect "*\$*"
    }
    "*\$*" {}
}

# Load images
send "echo '=== Loading frontend image ==='; sudo docker load < /tmp/frontend_v341.tar 2>&1; echo LOAD1_DONE\r"
expect "LOAD1_DONE*\$*"

send "echo '=== Loading backend image ==='; sudo docker load < /tmp/backend_v341.tar 2>&1; echo LOAD2_DONE\r"
expect "LOAD2_DONE*\$*"

# Tag images
send "sudo docker tag intelligist-datax-frontend:prod mso-frontend:prod 2>&1; echo TAG1_DONE\r"
expect "TAG1_DONE*\$*"
send "sudo docker tag intelligist-datax-backend:prod mso-backend:prod 2>&1; echo TAG2_DONE\r"
expect "TAG2_DONE*\$*"

# Stop + Remove old containers
send "sudo docker rm -f astro_frontend_uat astro_backend_uat 2>/dev/null; echo RM_DONE\r"
expect "RM_DONE*\$*"

# Start backend first (frontend depends on it)
send "sudo docker run -d --name astro_backend_uat --restart always -p 3010:7000 --network release_mso_l2e-network-uat -v uploads_data_uat:/app/uploads -e DB_HOST=db -e DB_USER=astro -e DB_PASS=password123 -e DB_NAME=psu_backend intelligist-datax-backend:prod 2>&1; echo RUN_BE_DONE\r"
expect "RUN_BE_DONE*\$*"

# Wait for backend to be ready
send "sleep 3; echo WAIT_DONE\r"
expect "WAIT_DONE*\$*"

# Start frontend
send "sudo docker run -d --name astro_frontend_uat --restart always -p 3001:80 --network release_mso_l2e-network-uat intelligist-datax-frontend:prod 2>&1; echo RUN_FE_DONE\r"
expect "RUN_FE_DONE*\$*"

# Verify
send "sleep 3; curl -s -o /dev/null -w '%{http_code}' http://localhost:3001; echo ' CURL_FE'\r"
expect "CURL_FE*\$*"

send "curl -s -o /dev/null -w '%{http_code}' http://localhost:3010/site-config; echo ' CURL_API'\r"
expect "CURL_API*\$*"

send "sudo docker ps --format '{{.Names}} {{.Status}}' | grep astro; echo PS_DONE\r"
expect "PS_DONE*\$*"

send "exit\r"
expect eof
