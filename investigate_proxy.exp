package require Expect

set timeout 30
set ip "110.78.210.128"
set user "administrator"
set pass "P@ssw0rd1234"

spawn ssh -t $user@$ip

expect {
    "password:" {
        send "$pass\r"
    }
}

expect "$ "
# 1. Check if containers are running correctly
send "sudo docker ps\r"
expect "password for administrator:"
send "$pass\r"

expect "$ "
# 2. Check frontend Nginx errors
send "sudo docker logs --tail 20 astro_frontend_uat\r"

expect "$ "
# 3. Test internal connectivity from frontend to backend
send "sudo docker exec astro_frontend_uat curl -I http://backend:7000/dashboard/stats\r"

expect "$ "
send "exit\r"
expect eof
