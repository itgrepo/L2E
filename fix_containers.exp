#!/usr/bin/expect -f
set timeout 30
spawn ssh -o StrictHostKeyChecking=no administrator@110.78.210.129
expect "*assword:*"
send "P@ssw0rd1234\r"
expect "*\$*"

send "sudo -v\r"
expect {
    "*assword*" {
        send "P@ssw0rd1234\r"
        expect "*\$*"
    }
    "*\$*" {}
}

# Check what's happening
send "sudo docker ps -a --format '{{.Names}} {{.Status}} {{.Image}}' | grep astro; echo PS_DONE\r"
expect "PS_DONE*\$*"

# Check frontend logs
send "sudo docker logs --tail 30 astro_frontend_uat 2>&1; echo LOG_FE_DONE\r"
expect "LOG_FE_DONE*\$*"

# Check backend logs
send "sudo docker logs --tail 30 astro_backend_uat 2>&1; echo LOG_BE_DONE\r"
expect "LOG_BE_DONE*\$*"

send "exit\r"
expect eof
