#!/usr/bin/expect -f
set timeout 300

# Step 1: SCP the image
spawn scp -o StrictHostKeyChecking=no /tmp/frontend_v341.tar administrator@110.78.210.129:/tmp/frontend_v341.tar
expect "*assword:*"
send "P@ssw0rd1234\r"
expect {
    "100%" {}
    eof {}
}
expect eof
puts "\n=== SCP Done ==="

# Step 2: SSH and deploy
spawn ssh -o StrictHostKeyChecking=no administrator@110.78.210.129
expect "*assword:*"
send "P@ssw0rd1234\r"
expect "*\$*"

send "sudo -v\r"
expect {
    "*assword*" {
        send "P@ssw0rd1234\r"
        expect "*\$*"
    }
    "*\$*" {}
}

# Load image
send "sudo docker load < /tmp/frontend_v341.tar 2>&1; echo LOAD_DONE\r"
expect "LOAD_DONE*\$*"

# Tag
send "sudo docker tag intelligist-datax-frontend:prod mso-frontend:prod 2>&1; echo TAG_DONE\r"
expect "TAG_DONE*\$*"

# Stop + Remove old
send "sudo docker rm -f astro_frontend_uat 2>/dev/null; echo RM_DONE\r"
expect "RM_DONE*\$*"

# Start new
send "sudo docker run -d --name astro_frontend_uat --restart always -p 3001:80 --network release_mso_l2e-network-uat intelligist-datax-frontend:prod 2>&1; echo RUN_DONE\r"
expect "RUN_DONE*\$*"

# Quick verify
send "curl -s -o /dev/null -w '%{http_code}' http://localhost:3001; echo ' CURL_DONE'\r"
expect "CURL_DONE*\$*"

send "exit\r"
expect eof
