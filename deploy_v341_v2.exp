#!/usr/bin/expect -f
set timeout 120
spawn ssh -o StrictHostKeyChecking=no administrator@110.78.210.129
expect "*assword:*"
send "P@ssw0rd1234\r"
expect "*\$*"

# Cache sudo password first
send "sudo -v\r"
expect {
    "*assword*" {
        send "P@ssw0rd1234\r"
        expect "*\$*"
    }
    "*\$*" {}
}

# Step 1: Load the new frontend image
send "echo '=== Step 1: Loading new frontend image ==='\r"
expect "*\$*"
send "sudo docker load < /tmp/frontend_v341.tar 2>&1\r"
expect "*\$*"

# Step 2: Tag it
send "echo '=== Step 2: Tagging image ==='\r"
expect "*\$*"
send "sudo docker tag intelligist-datax-frontend:prod mso-frontend:prod 2>&1\r"
expect "*\$*"

# Step 3: Check network name
send "echo '=== Step 3: Finding Docker network ==='\r"
expect "*\$*"
send "sudo docker network ls | grep l2e 2>&1\r"
expect "*\$*"

# Step 4: Stop old frontend container
send "echo '=== Step 4: Stopping old frontend container ==='\r"
expect "*\$*"
send "sudo docker stop astro_frontend_uat 2>&1\r"
expect "*\$*"
send "sudo docker rm astro_frontend_uat 2>&1\r"
expect "*\$*"

# Step 5: Start new frontend container with same port mapping
send "echo '=== Step 5: Starting new frontend container ==='\r"
expect "*\$*"

# Get the network name dynamically
send "NETNAME=$(sudo docker network ls --format '{{.Name}}' | grep l2e | head -1) && echo \"Using network: $NETNAME\"\r"
expect "*\$*"
send "sudo docker run -d --name astro_frontend_uat --restart always -p 3001:80 --network $NETNAME intelligist-datax-frontend:prod 2>&1\r"
expect "*\$*"

# Step 6: Verify
send "echo '=== Step 6: Verifying ==='\r"
expect "*\$*"
send "sudo docker ps | grep astro\r"
expect "*\$*"

# Step 7: Inject developer user
send "echo '=== Step 7: Injecting developer user ==='\r"
expect "*\$*"
send "sudo docker exec -i astro_db_uat mysql -uastro -ppassword123 psu_backend -e \"SELECT user_id, username FROM user WHERE username='developer';\" 2>&1\r"
expect "*\$*"

send "exit\r"
expect eof
