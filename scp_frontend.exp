#!/usr/bin/expect -f
set timeout 300
spawn scp -o StrictHostKeyChecking=no /tmp/frontend_v341.tar administrator@110.78.210.129:/tmp/frontend_v341.tar
expect "*assword:*"
send "P@ssw0rd1234\r"
expect {
    "100%" { puts "\nSCP completed successfully" }
    timeout { puts "\nSCP timed out" }
    eof {}
}
expect eof
