#!/usr/bin/expect -f
set timeout 300
spawn ssh -o StrictHostKeyChecking=no administrator@110.78.210.129
expect "*assword:*"
send "P@ssw0rd1234\r"
expect "*\$*"

# Get sudo first
send "sudo ls /tmp/*.tar\r"
expect {
    "*assword*" {
        send "P@ssw0rd1234\r"
        expect "*\$*"
    }
    "*\$*" {}
}

# Now sudo is cached - load images
send "sudo docker load < /tmp/frontend_v341.tar 2>&1 | tail -2; echo LOAD1_OK\r"
expect "LOAD1_OK"
expect "*\$*"

send "sudo docker load < /tmp/backend_v341.tar 2>&1 | tail -2; echo LOAD2_OK\r"
expect "LOAD2_OK"
expect "*\$*"

# Tag
send "sudo docker tag intelligist-datax-frontend:prod mso-frontend:prod && sudo docker tag intelligist-datax-backend:prod mso-backend:prod && echo TAG_OK\r"
expect "TAG_OK"
expect "*\$*"

# Restart containers
send "sudo docker rm -f astro_frontend_uat astro_backend_uat 2>/dev/null; echo RM_OK\r"
expect "RM_OK"
expect "*\$*"

send "sudo docker run -d --name astro_backend_uat --restart always --network-alias backend -p 3010:7000 --network release_mso_l2e-network-uat -v uploads_data_uat:/app/uploads -e DB_HOST=db -e DB_USER=astro -e DB_PASS=password123 -e DB_NAME=psu_backend intelligist-datax-backend:prod 2>&1; echo BE_OK\r"
expect "BE_OK"
expect "*\$*"

send "sleep 5; echo WAIT\r"
expect "WAIT"
expect "*\$*"

send "sudo docker run -d --name astro_frontend_uat --restart always -p 3001:80 --network release_mso_l2e-network-uat intelligist-datax-frontend:prod 2>&1; echo FE_OK\r"
expect "FE_OK"
expect "*\$*"

send "sleep 3; curl -s -o /dev/null -w '%{http_code}' http://localhost:3001; echo ' CURL_OK'\r"
expect "CURL_OK"
expect "*\$*"

send "curl -s http://localhost:3010/page-layout | head -c 60; echo ' LAYOUT_OK'\r"
expect "LAYOUT_OK"
expect "*\$*"

send "sudo docker ps --format '{{.Names}} {{.Status}}' | grep astro; echo PS_OK\r"
expect "PS_OK"
expect "*\$*"

send "exit\r"
expect eof
