package require Expect

set timeout 30
set ip "110.78.210.128"
set user "administrator"
set pass "P@ssw0rd1234"

spawn ssh -t $user@$ip

expect {
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$pass\r"
    }
}

expect "$ "
# Run docker logs and capture last 50 lines
send "sudo docker logs --tail 50 astro_backend_uat\r"
expect "password for administrator:"
send "$pass\r"

# Capture the output
expect "$ "
set output $expect_out(buffer)

puts "\n--- DOCKER LOGS START ---"
puts $output
puts "--- DOCKER LOGS END ---\n"

send "exit\r"
expect eof
